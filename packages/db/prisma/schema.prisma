generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CONTRIBUTOR
  MAINTAINER
  MENTOR
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

// Platform staff. Everyone else's roles (contributor, mentor, project admin) come from
// their approved registrations; see lib/roles.ts in apps/web.
enum StaffRole {
  ORGANIZER
  SUPER_ADMIN
}

// ---------------------------------------------------------------------------
// Auth (Better Auth). Column names follow what the Better Auth Prisma adapter
// expects, so change them only together with lib/auth.ts in apps/web.
// ---------------------------------------------------------------------------

model User {
  id                 String     @id
  name               String
  email              String     @unique
  emailVerified      Boolean    @default(false)
  image              String?
  // GitHub's numeric id lives in Account.accountId (it never changes), and everything
  // that belongs to a person (points, PRs) is keyed by User.id, never by login.
  // The login is refreshed on every sign-in because users can rename themselves.
  githubLogin        String?    @unique
  isAdmin            Boolean    @default(false)
  // Can undo a finalized leaderboard (PRD §4.8). Promoted from SUPER_ADMIN_GITHUB_LOGINS on sign-in.
  isSuperAdmin       Boolean    @default(false)
  // Null for everyone who is not platform staff.
  staffRole          StaffRole?
  // Set while the person is banned. Banning also deletes their sessions.
  bannedAt           DateTime?
  banReason          String?
  // Set by 3 spam strikes or an organizer; PRs merged after it don't score (AUTHOR_SANCTIONED).
  scoringSuspendedAt DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  sessions       Session[]
  accounts       Account[]
  profile        Profile?
  registrations  Registration[]
  projects       Project[]
  reviews        ProjectReview[]
  emails         EmailOutbox[]
  pullRequests   PullRequest[]
  scoreEvents    ScoreEvent[]
  badges         UserBadge[]
  disputes       Dispute[]
  mentorships    ProjectMentor[]
  mentorPoints   MentorPointEvent[]
  flagsRaised    Flag[]             @relation("FlagReporter")
  flagsReceived  Flag[]             @relation("FlagTarget")
  collegeAliases CollegeAlias[]
  auditLogsActed AuditLog[]         @relation("AuditActor")
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ---------------------------------------------------------------------------
// Registration
// ---------------------------------------------------------------------------

// One per user: details shared across every role they sign up for.
model Profile {
  id                      String        @id @default(cuid())
  userId                  String        @unique
  // What the person typed or picked, kept as their own words.
  college                 String
  // The curated college it resolves to: picked from the list (USER), or matched through an
  // organizer's alias (ALIAS). Null until one of the two happens; unmatched profiles are not on
  // college boards.
  collegeId               String?
  collegeMatch            CollegeMatch?
  graduationYear          Int
  phone                   String?
  discord                 String?
  codeOfConductAcceptedAt DateTime
  updatesOptIn            Boolean       @default(false)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  collegeRecord College? @relation(fields: [collegeId], references: [id], onDelete: SetNull)

  @@index([collegeId])
  @@index([graduationYear])
}

enum CollegeMatch {
  USER
  ALIAS
}

// ---------------------------------------------------------------------------
// Colleges (F-08). A curated list: AICTE-approved technical institutions and UGC-recognised
// universities, imported with `pnpm --filter backend colleges:import`, plus ones organizers add.
// ---------------------------------------------------------------------------

enum CollegeSource {
  AICTE
  UGC
  ADMIN
}

model College {
  id        String        @id @default(cuid())
  slug      String        @unique
  name      String
  // Full state or union territory name, e.g. "Tamil Nadu". Used by the leaderboard filter.
  state     String
  city      String?
  source    CollegeSource
  // The id in the source dataset (AICTE permanent id, UGC id); null for ADMIN.
  sourceId  String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  aliases  CollegeAlias[]
  profiles Profile[]

  @@unique([source, sourceId])
  @@index([name])
  @@index([state])
}

// Other names for a college: abbreviations and spellings from the dataset, and organizers'
// mappings of what people typed. `normalized` is normaliseCollegeName() of the text.
model CollegeAlias {
  id          String   @id @default(cuid())
  collegeId   String
  normalized  String   @unique
  label       String
  // The organizer who mapped it; null for aliases from a dataset import.
  createdById String?
  createdAt   DateTime @default(now())

  college   College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  createdBy User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([collegeId])
}

// One per (user, role). A person can be a maintainer and a mentor at once, and
// each role has its own review status.
model Registration {
  id           String             @id @default(cuid())
  userId       String
  role         Role
  status       RegistrationStatus @default(PENDING)
  // Optional repo link given at sign-up (maintainers). Project submission is a later phase.
  repoUrl      String?
  // Role-specific answers (e.g. mentor expertise) so the schema doesn't change per question.
  answers      Json?
  // When and by whom an organizer approved or rejected it (mentors and maintainers).
  reviewedAt   DateTime?
  reviewedById String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role, status])
}

// ---------------------------------------------------------------------------
// Seasons (F-03). Only what projects need today: F-03 adds dates, scoring rules
// and toggles. Exactly one season is active; that is enforced in code
// (activeSeason() in apps/web/lib/projects-server.ts), not by the database.
// ---------------------------------------------------------------------------

model Season {
  id             String    @id @default(cuid())
  slug           String    @unique
  name           String
  isActive       Boolean   @default(false)
  // The contribution window: only PRs merged inside it score. Unset means nothing scores yet.
  codingStartsAt DateTime?
  codingEndsAt   DateTime?
  // Overrides for the default label names, points and caps (resolveRules() in packages/scoring).
  scoringRules   Json?

  // Leaderboard freeze (PRD §4.8). While frozen, every rank shown (public boards, /me and the
  // dashboard) comes from freezeSnapshotId; scoring carries on underneath.
  leaderboardFrozenAt   DateTime?
  // Null when the worker froze it automatically (48 h before codingEndsAt).
  leaderboardFrozenById String?
  // Off after an organizer unfreezes, so the worker doesn't freeze it again.
  leaderboardAutoFreeze Boolean   @default(true)
  freezeSnapshotId      String?
  // Finalized: the ledger is locked and finalSnapshotId holds the official ranks.
  finalizedAt           DateTime?
  finalizedById         String?
  finalSnapshotId       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects             Project[]
  pullRequests         PullRequest[]
  scoreEvents          ScoreEvent[]
  badges               UserBadge[]
  disputes             Dispute[]
  mentorPoints         MentorPointEvent[]
  flags                Flag[]
  leaderboardSnapshots LeaderboardSnapshot[]

  events     Event[]
  changeLogs SeasonChangeLog[]
}

// ---------------------------------------------------------------------------
// Projects (F-04). A project admin (a user with the MAINTAINER role) applies with
// 1 to 10 GitHub repos; organizers review the application.
// ---------------------------------------------------------------------------

enum ProjectStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
}

// Whether organizers have accepted a repo. Repos in the application are accepted
// together with the project; repos added after approval wait for an organizer
// (anti-abuse, PRD section 10).
enum RepoApproval {
  PENDING
  APPROVED
  REJECTED
}

// Whether the GitHub App is installed on the repo (set by F-06's installation
// webhooks). Scoring only runs for ACTIVE repos.
enum RepoTrackingStatus {
  NOT_INSTALLED
  ACTIVE
  SUSPENDED
}

model Project {
  id               String        @id @default(cuid())
  seasonId         String
  ownerId          String
  // Unique within a season, so a returning project can keep its slug next season.
  slug             String
  name             String
  // Markdown, rendered without raw HTML.
  description      String
  techStack        String[]
  // Expected share of issues per level, in percent. The three add up to 100.
  difficultyEasy   Int
  difficultyMedium Int
  difficultyHard   Int
  // Optional override; otherwise the first repo owner's GitHub avatar is shown.
  logoUrl          String?
  discordChannel   String?
  contributingUrl  String?
  expectedMentors  Int           @default(0)
  // SPDX identifier, e.g. "MIT".
  license          String
  status           ProjectStatus @default(DRAFT)
  // The latest reason shown to the project admin (changes requested, rejected).
  publicReason     String?
  // The project this application was copied from (a previous season's).
  copiedFromId     String?
  submittedAt      DateTime?
  approvedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  season     Season          @relation(fields: [seasonId], references: [id])
  owner      User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  copiedFrom Project?        @relation("ProjectCopies", fields: [copiedFromId], references: [id], onDelete: SetNull)
  copies     Project[]       @relation("ProjectCopies")
  repos      ProjectRepo[]
  reviews    ProjectReview[]
  mentors    ProjectMentor[]

  @@unique([seasonId, slug])
  @@index([seasonId, status])
  @@index([ownerId])
}

model ProjectRepo {
  id              String             @id @default(cuid())
  projectId       String
  // GitHub's numeric repo id never changes, even when a repo is renamed or
  // transferred; owner and name are refreshed from GitHub.
  githubRepoId    BigInt
  owner           String
  name            String
  approval        RepoApproval       @default(PENDING)
  trackingStatus  RepoTrackingStatus @default(NOT_INSTALLED)
  // The last GitHub validation: which checks passed (see lib/github.ts in apps/web).
  validation      Json?
  validatedAt     DateTime?
  // Removing a repo stops future scoring but keeps the row (and its earned points).
  removedAt       DateTime?
  // Set by the GitHub App's installation webhooks (F-06).
  installationId  BigInt?
  defaultBranch   String?
  // The last full sync (installation or nightly reconciliation).
  lastSyncedAt    DateTime?
  // Program labels the repo still lacks after the worker tried to create them (repo health).
  missingLabels   String[]           @default([])
  labelsCheckedAt DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pullRequests PullRequest[]
  issues       ProgramIssue[]

  @@unique([projectId, githubRepoId])
  @@index([githubRepoId])
}

// One row per status change or reviewer note on a project: the review history and its audit
// trail. The project admin's own submissions are recorded too (actor = the PA).
model ProjectReview {
  id           String         @id @default(cuid())
  projectId    String
  // Null once the acting user's account is deleted; the history itself is kept.
  actorId      String?
  // Both set for a status change; both null for a note on its own.
  fromStatus   ProjectStatus?
  toStatus     ProjectStatus?
  // Seen by organizers only.
  internalNote String?
  // Shown to the project admin (and emailed to them).
  publicReason String?
  createdAt    DateTime       @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
}

// ---------------------------------------------------------------------------
// Email. Every transactional email is written here first, in the same
// transaction as the change it reports, then delivered (lib/email.ts in
// apps/web). Rows still PENDING can be retried; F-13 adds the retry worker.
// ---------------------------------------------------------------------------

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

model EmailOutbox {
  id        String      @id @default(cuid())
  toEmail   String
  toUserId  String?
  // What the email is about, e.g. "project-status", so F-13 can honour per-category mutes.
  category  String
  subject   String
  text      String
  html      String
  status    EmailStatus @default(PENDING)
  attempts  Int         @default(0)
  lastError String?
  sentAt    DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  toUser User? @relation(fields: [toUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// PR tracking (F-06). The GitHub App's webhooks land in WebhookDelivery and queue a SyncJob;
// the worker in apps/backend refetches the PR from GitHub and stores it here.
// ---------------------------------------------------------------------------

// Every webhook GitHub sends. The delivery id is the key, so redeliveries are ignored.
model WebhookDelivery {
  id                String               @id
  event             String
  action            String?
  githubRepoId      BigInt?
  installationId    BigInt?
  payload           Json
  receivedAt        DateTime             @default(now())

  // Webhook monitoring & replay fields
  installationRefId String?
  status            Int?
  success           Boolean              @default(true)
  responseBody      String?
  durationMs        Int?
  deliveredAt       DateTime             @default(now())

  installation      WebhookInstallation? @relation(fields: [installationRefId], references: [id], onDelete: Cascade)

  @@index([receivedAt])
  @@index([installationRefId, deliveredAt])
  @@index([event])
  @@index([success])
}

enum SyncJobKind {
  MENTOR_ACCESS
  PULL_REQUEST
  ISSUE
  REPO_RESYNC
  INSTALLATION
  REPOSITORY
  USER_RESCORE
  LEADERBOARD_REFRESH
}

enum SyncJobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

// A Postgres-backed job queue. At most one QUEUED job per dedupeKey (a partial unique index in
// the migration), so a burst of webhooks for one PR becomes one refetch.
model SyncJob {
  id         String        @id @default(cuid())
  kind       SyncJobKind
  // e.g. "pr:<githubRepoId>:<number>". Jobs refetch current state, so one queued job is enough.
  dedupeKey  String
  payload    Json
  status     SyncJobStatus @default(QUEUED)
  runAt      DateTime      @default(now())
  attempts   Int           @default(0)
  lockedAt   DateTime?
  lastError  String?
  finishedAt DateTime?
  createdAt  DateTime      @default(now())

  @@index([status, runAt])
  @@index([dedupeKey])
}

enum PullRequestState {
  OPEN
  CLOSED
  MERGED
}

enum PrLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

// The scoring outcome shown on the dashboard. INVALIDATED: invalid/spam label or reverted.
enum PrScoreStatus {
  OPEN
  CLOSED
  AWAITING_LABEL
  SCORED
  NOT_ELIGIBLE
  INVALIDATED
}

// Fixed reason codes (PRD §4.2). Keep in sync with REASON_CODES in packages/scoring.
enum ScoreReason {
  NOT_REGISTERED
  NO_PROGRAM_LABEL
  NO_LEVEL_LABEL
  MULTIPLE_LEVEL_LABELS
  OUTSIDE_WINDOW
  REPO_NOT_TRACKED
  WRONG_BASE_BRANCH
  SELF_MERGED
  AUTHOR_IS_MENTOR
  CAP_REACHED
  INVALID_LABEL
  SPAM_LABEL
  REVERTED
  AUTHOR_SANCTIONED
}

model PullRequest {
  id                  String           @id @default(cuid())
  repoId              String
  // The repo's project's season, copied here for fast per-season queries.
  seasonId            String
  githubId            BigInt
  number              Int
  title               String
  url                 String
  authorGithubId      BigInt
  authorLogin         String
  // Linked when the author has a Mergio account (now or when they sign up later).
  authorId            String?
  state               PullRequestState
  isDraft             Boolean          @default(false)
  baseRef             String
  labels              String[]
  linkedIssueNumbers  Int[]
  linkedIssueLabels   String[]
  // Per closed issue: the GitHub id of who added its level label (or program label), for mentor
  // points. [{ "number": 12, "githubId": "123" }]
  linkedIssueLabelers Json?
  additions           Int              @default(0)
  deletions           Int              @default(0)
  // Changed non-whitespace lines; null when not measured (large diffs).
  changedLines        Int?
  mergedAt            DateTime?
  mergedByGithubId    BigInt?
  mergedByLogin       String?
  closedAt            DateTime?
  // Set on a revert PR ("Reverts owner/repo#12"): the number of the PR it reverts.
  revertsNumber       Int?
  // GitHub ids of reviewers who approved it (mentor points, PRD §4.5).
  approvedByGithubIds BigInt[]
  githubCreatedAt     DateTime
  githubUpdatedAt     DateTime

  scoreStatus   PrScoreStatus @default(OPEN)
  scoreReason   ScoreReason?
  level         PrLevel?
  // Net points on the ledger for this PR (kept in step with ScoreEvent).
  points        Int           @default(0)
  // While AWAITING_LABEL: when the grace window ends and it is scored for good.
  labelDeadline DateTime?
  // Explanations for the contributor (level from the linked issue, capped to beginner, ...).
  scoreNotes    String[]
  scoredAt      DateTime?
  lastSyncedAt  DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  repo         ProjectRepo        @relation(fields: [repoId], references: [id], onDelete: Cascade)
  season       Season             @relation(fields: [seasonId], references: [id])
  author       User?              @relation(fields: [authorId], references: [id], onDelete: SetNull)
  labelEvents  PrLabelEvent[]
  mentorPoints MentorPointEvent[]
  flags        Flag[]
  scoreEvents  ScoreEvent[]
  disputes     Dispute[]

  @@unique([repoId, number])
  @@index([githubId])
  @@index([authorId, seasonId])
  @@index([authorGithubId])
  @@index([scoreStatus, labelDeadline])
}

enum LabelAction {
  ADDED
  REMOVED
}

// The label history of a PR, from GitHub's timeline (who labelled what, when).
model PrLabelEvent {
  id            String      @id @default(cuid())
  pullRequestId String
  githubEventId String      @unique
  label         String
  action        LabelAction
  actorLogin    String?
  createdAt     DateTime

  pullRequest PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)

  @@index([pullRequestId, createdAt])
}

// ---------------------------------------------------------------------------
// Scoring ledger (F-07). Append-only: a change in a PR's worth is a new entry for the difference
// (or a reversal), never an edit. A contributor's points are the sum of their entries that are
// already effective; the daily cap can make an entry effective later than it was written.
// ---------------------------------------------------------------------------

enum ScoreEventKind {
  AWARD
  REVERSAL
  ADJUSTMENT
  DISPUTE_CORRECTION
}

model ScoreEvent {
  id             String         @id @default(cuid())
  seasonId       String
  userId         String
  pullRequestId  String?
  kind           ScoreEventKind
  // "base", "bonus:quality", ...; adjustments and dispute corrections use their own keys.
  ruleKey        String
  points         Int
  level          PrLevel?
  // What the entry is for, shown in the points ledger.
  description    String
  // For a reversal: why the points were taken back.
  reason         ScoreReason?
  effectiveAt    DateTime
  // prId:ruleKey:sequence, so a duplicate write fails instead of double counting.
  idempotencyKey String         @unique
  createdAt      DateTime       @default(now())

  season      Season       @relation(fields: [seasonId], references: [id])
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  pullRequest PullRequest? @relation(fields: [pullRequestId], references: [id], onDelete: SetNull)

  @@index([seasonId, userId, effectiveAt])
  @@index([seasonId, effectiveAt])
  @@index([pullRequestId])
}

// ---------------------------------------------------------------------------
// Badges (F-15). Definitions are synced from BADGES in packages/scoring.
// ---------------------------------------------------------------------------

model BadgeDefinition {
  key         String   @id
  name        String
  description String
  ruleKey     String
  threshold   Int
  sortOrder   Int
  updatedAt   DateTime @updatedAt

  awards UserBadge[]
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  seasonId String
  badgeKey String
  earnedAt DateTime @default(now())

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  season Season          @relation(fields: [seasonId], references: [id])
  badge  BadgeDefinition @relation(fields: [badgeKey], references: [key])

  @@unique([userId, seasonId, badgeKey])
}

// ---------------------------------------------------------------------------
// Issues (F-09): open program issues on tracked repos, for discovery and recommendations.
// ---------------------------------------------------------------------------

enum IssueState {
  OPEN
  CLOSED
}

model ProgramIssue {
  id              String     @id @default(cuid())
  repoId          String
  githubId        BigInt
  number          Int
  title           String
  url             String
  state           IssueState
  labels          String[]
  level           PrLevel?
  assigneeCount   Int        @default(0)
  githubCreatedAt DateTime
  githubUpdatedAt DateTime
  lastSyncedAt    DateTime   @default(now())

  repo ProjectRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([repoId, number])
  @@index([state, level])
}

// ---------------------------------------------------------------------------
// Disputes (F-12). Contributors open them from the dashboard; organizers resolve them in the
// admin console (later). An upheld dispute adds a DISPUTE_CORRECTION ledger entry.
// ---------------------------------------------------------------------------

enum DisputeCategory {
  WRONG_LEVEL
  MISSING_POINTS
  WRONGLY_INELIGIBLE
  WRONGLY_INVALIDATED
  OTHER
}

enum DisputeStatus {
  OPEN
  IN_REVIEW
  UPHELD
  REJECTED
}

model Dispute {
  id            String          @id @default(cuid())
  seasonId      String
  userId        String
  pullRequestId String
  category      DisputeCategory
  text          String
  evidenceUrls  String[]
  status        DisputeStatus   @default(OPEN)
  resolvedAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  season      Season      @relation(fields: [seasonId], references: [id])
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  pullRequest PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([pullRequestId])
  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Mentors (F-05). A project admin invites mentors by GitHub login; the row links to the user
// once they have signed in. A mentor is active when linked and their MENTOR registration is
// APPROVED by an organizer. Deleting the row removes access immediately.
// ---------------------------------------------------------------------------

model ProjectMentor {
  id              String    @id @default(cuid())
  projectId       String
  // Lower-cased login as invited.
  githubLogin     String
  userId          String?
  invitedById     String?
  // GitHub role per repo ("owner/name" -> "triage", "write", ... or "none"), checked by the
  // worker: mentors need at least triage to apply labels.
  repoAccess      Json?
  accessCheckedAt DateTime?
  createdAt       DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, githubLogin])
  @@index([userId])
}

// Mentor points (PRD §4.5), separate from contributor scores. Append-only like ScoreEvent:
// ruleKey is "review:<pullRequestId>" (+5 per approving review on a scored PR) or
// "issue:<repoId>#<number>" (+2 when an issue the mentor labelled gets a scored PR).
model MentorPointEvent {
  id             String   @id @default(cuid())
  seasonId       String
  userId         String
  pullRequestId  String?
  ruleKey        String
  points         Int
  description    String
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  season      Season       @relation(fields: [seasonId], references: [id])
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  pullRequest PullRequest? @relation(fields: [pullRequestId], references: [id], onDelete: SetNull)

  @@index([seasonId, userId, createdAt])
  @@index([ruleKey])
}

// ---------------------------------------------------------------------------
// Flags (F-12): mentors, project admins and organizers report abuse. Organizers act on them
// in the admin console (F-11).
// ---------------------------------------------------------------------------

enum FlagCategory {
  SPAM
  PLAGIARISM
  LOW_QUALITY_AI
  MULTIPLE_ACCOUNTS
  OTHER
}

enum FlagStatus {
  OPEN
  ACTIONED
  DISMISSED
}

model Flag {
  id                String       @id @default(cuid())
  seasonId          String
  reporterId        String
  // The flagged person: a user when they have an account, always their GitHub login.
  targetUserId      String?
  targetGithubLogin String
  pullRequestId     String?
  category          FlagCategory
  note              String
  status            FlagStatus   @default(OPEN)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  season      Season       @relation(fields: [seasonId], references: [id])
  reporter    User         @relation("FlagReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetUser  User?        @relation("FlagTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  pullRequest PullRequest? @relation(fields: [pullRequestId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetUserId])
  @@index([reporterId, pullRequestId])
}

// ---------------------------------------------------------------------------
// Leaderboard snapshots (F-08). Redis serves the boards, but a freeze or a finalize is a
// permanent record, so its ranks live here and Redis loads them back on a cache miss.
// ---------------------------------------------------------------------------

enum LeaderboardSnapshotKind {
  FREEZE
  FINAL
}

model LeaderboardSnapshot {
  id        String                  @id @default(cuid())
  seasonId  String
  kind      LeaderboardSnapshotKind
  // The instant the ranks were computed at.
  takenAt   DateTime
  takenById String?
  createdAt DateTime                @default(now())

  season  Season                     @relation(fields: [seasonId], references: [id])
  entries LeaderboardSnapshotEntry[]

  @@index([seasonId, kind])
}

model LeaderboardSnapshotEntry {
  snapshotId   String
  // "overall", "weekly:2026-11-16", "project:<id>", "college:<id>", "colleges", "mentors"
  board        String
  // A user id, or a college id on the "colleges" board.
  entityId     String
  rank         Int
  points       Int
  advanced     Int
  intermediate Int
  beginner     Int
  reachedAt    DateTime

  snapshot LeaderboardSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@id([snapshotId, board, entityId])
  @@index([snapshotId, board, rank])
}

// ---------------------------------------------------------------------------
// Audit Log — every admin write is recorded here with actor, table, record,
// and a JSON snapshot of the before/after values.
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  // The admin who performed the action.
  actorId    String
  // Human-readable action name, e.g. "APPROVE_REGISTRATION", "BAN_USER", "ADJUST_SCORE".
  action     String
  // The Prisma model/table this action touched, e.g. "Registration", "User", "Score".
  entity     String
  // The primary key of the affected row.
  entityId   String
  // Full snapshots so the log is self-contained even if the row changes later.
  before     Json?
  after      Json?
  // Optional free-text note (required for certain actions like score adjustments).
  reason     String?
  createdAt  DateTime @default(now())

  actor User @relation("AuditActor", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// A Season contains one or more Events (e.g., "Week 1 Sprint", "Finals").
// Each event has its own timeline and can override the season-level config.
// ---------------------------------------------------------------------------

model Event {
  id          String    @id @default(cuid())
  seasonId    String
  name        String    // e.g. "Week 1 Sprint"
  slug        String    // URL-safe, unique within a season
  description String?
  startsAt    DateTime
  endsAt      DateTime
  isActive    Boolean   @default(false)
  // Per-event config overrides (scoring multipliers, labels, etc.)
  config      Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  season  Season  @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([seasonId, slug])
  @@index([seasonId])
}

// Every time an admin edits a Season row, a SeasonChangeLog entry is written
// with the before/after values, mirroring AuditLog but kept separate so the
// Season history page can be rendered without scanning the full audit log.
model SeasonChangeLog {
  id        String   @id @default(cuid())
  seasonId  String
  actorId   String
  // Which field(s) changed, e.g. "config.scoringRules".
  field     String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@index([seasonId, createdAt])
}

// ---------------------------------------------------------------------------
// Webhook — tracks GitHub App installations and their delivery history.
// ---------------------------------------------------------------------------

model WebhookInstallation {
  id              String    @id @default(cuid())
  // GitHub's own installation id (numeric, stored as string to avoid bigint issues).
  githubId        String    @unique
  // The GitHub account (org or user) that installed the app.
  accountLogin    String
  accountType     String    // "Organization" | "User"
  // Repository full names covered by this installation (may be a subset).
  repoFullNames   String[]  @default([])
  // Whether the installation is currently active.
  isActive        Boolean   @default(true)
  installedAt     DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  deliveries WebhookDelivery[]
}

