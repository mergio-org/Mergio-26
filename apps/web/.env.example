DATABASE_URL="postgresql://postgres:postgres@localhost:5433/mergio?schema=public"

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public URL of this app. http://localhost:3001 in dev, https://mergio.in in production.
BETTER_AUTH_URL="http://localhost:3001"

# GitHub OAuth App (GitHub > Settings > Developer settings > OAuth Apps).
# Callback URL: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Comma-separated GitHub usernames that become super admins on sign-in.
# Organizers are added by a super admin: PUT /api/v1/admin/users/{id}/staff-role.
ADMIN_GITHUB_LOGINS=""
# Super Admins are organizers who can also unfinalize a leaderboard.
SUPER_ADMIN_GITHUB_LOGINS=""

# Leaderboard cache (F-08). On Vercel use Upstash's REST API; locally, the Redis from
# docker-compose. With neither, leaderboards are computed in Postgres on every read.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
REDIS_URL="redis://localhost:6380"

# Production only: share the session cookie with admin.mergio.in.
# Leave empty in development.
AUTH_COOKIE_DOMAIN=""

# Transactional email through Resend (https://resend.com). Without a key, emails are only
# written to the EmailOutbox table and logged, never sent.
RESEND_API_KEY=""
# Must be on a domain verified in Resend.
EMAIL_FROM="Mergio <noreply@mergio.in>"

# The Mergio GitHub App's URL name (github.com/apps/<slug>), once it exists (F-06).
# Approved projects get a link to install it.
GITHUB_APP_SLUG=""

# The GitHub App's webhook secret (GitHub App settings > Webhook secret). Webhooks are sent to
# <BETTER_AUTH_URL>/api/v1/webhooks/github and rejected (503) until this is set.
GITHUB_WEBHOOK_SECRET=""

# Image uploads for site content (F-16): S3 or Cloudflare R2. Organizers upload sponsor logos,
# team photos and page images straight from the browser with presigned PUT URLs.
# R2: S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com", S3_REGION="auto".
# S3:  S3_ENDPOINT="https://s3.<region>.amazonaws.com", S3_REGION="<region>".
# S3_PUBLIC_URL is the public base URL of the bucket (R2 public bucket / custom domain, or CloudFront).
# The bucket needs a CORS rule allowing PUT with a Content-Type header from BETTER_AUTH_URL.
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""
