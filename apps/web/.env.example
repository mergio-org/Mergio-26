DATABASE_URL="postgresql://postgres:postgres@localhost:5433/mergio?schema=public"

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public URL of this app. http://localhost:3001 in dev, https://mergio.in in production.
BETTER_AUTH_URL="http://localhost:3001"

# GitHub OAuth App (GitHub > Settings > Developer settings > OAuth Apps).
# Callback URL: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Comma-separated GitHub usernames that get admin access on sign-in.
ADMIN_GITHUB_LOGINS=""

# Production only: share the session cookie with admin.mergio.in.
# Leave empty in development.
AUTH_COOKIE_DOMAIN=""
